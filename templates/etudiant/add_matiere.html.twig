{% extends 'base.html.twig' %}

{% block title %}Ajouter Matière à {{ etudiant.prenom }}{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <!-- Card wrapper -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-journal-plus"></i> Ajouter une matière à {{ etudiant.prenom }} {{ etudiant.nom }}
                    </h4>
                </div>
                <div class="card-body">

                    {{ form_start(form) }}

                        {# Matière select field #}
                        <div class="mb-3">
                            {{ form_label(form.matiere) }}
                            {{ form_widget(form.matiere, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.matiere) }}
                        </div>

                        {# Absences input field #}
                        <div class="mb-3">
                            {{ form_label(form.absences) }}
                            {{ form_widget(form.absences, {'attr': {'class': 'form-control', 'min': 0}}) }}
                            {{ form_errors(form.absences) }}
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a href="{{ path('app_etudiant_show', {'id': etudiant.id}) }}" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Retour
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Ajouter
                            </button>
                        </div>

                    {{ form_end(form) }}

                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
