{% extends 'base.html.twig' %}

{% block title %}Liste des Étudiants{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold text-primary">Liste des Étudiants</h1>
        <a href="{{ path('app_etudiant_new') }}" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Ajouter un étudiant
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Nom</th>
                        <th scope="col">Prénom</th>
                        <th scope="col">Email</th>
                        <th scope="col">Absences totales</th>
                        <th scope="col">Photo</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for etudiant in etudiants %}
                    <tr>
                        <td>{{ etudiant.id }}</td>
                        <td>{{ etudiant.nom }}</td>
                        <td>{{ etudiant.prenom }}</td>
                        <td>{{ etudiant.email }}</td>
                        <td>
                            <span class="badge bg-warning text-dark">{{ etudiant.getTotalAbsences() }}</span>
                        </td>
                        <td>
                            {% if etudiant.photo %}
                                <img src="{{ asset('uploads/photos/' ~ etudiant.photo) }}" alt="Photo" class="rounded-circle" width="50" height="50">
                            {% else %}
                                <span class="text-muted">Aucune</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_etudiant_show', {'id': etudiant.id}) }}" class="btn btn-sm btn-info text-white">
                                <i class="bi bi-eye"></i> Voir
                            </a>
                            <a href="{{ path('app_etudiant_edit', {'id': etudiant.id}) }}" class="btn btn-sm btn-warning text-white">
                                <i class="bi bi-pencil"></i> Modifier
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-muted">Aucun étudiant trouvé</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
