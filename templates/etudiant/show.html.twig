{% extends 'base.html.twig' %}

{% block title %}Détails Étudiant{% endblock %}

{% block body %}
<div class="container mt-4">
    <h2 class="mb-4 text-center">Détails de l'étudiant</h2>

    <div class="card mb-4 shadow-sm">
        <div class="card-body d-flex align-items-center gap-4">
            <img src="{{ etudiant.photo ? asset(photos_basepath ~ '/' ~ etudiant.photo) : asset('images/placeholder-user.png') }}"
                 alt="Photo"
                 class="rounded-circle border"
                 width="100"
                 height="100">

            <div>
                <h4 class="mb-1">{{ etudiant.prenom }} {{ etudiant.nom }}</h4>
                <p class="mb-0 text-muted"><i class="bi bi-envelope"></i> {{ etudiant.email }}</p>

                {# Compute total absences dynamically from Absence entities #}
                {% set totalAbsences = etudiant.absences|length %}
                <p class="mb-0"><strong>Total absences:</strong> {{ totalAbsences }}</p>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <a href="{{ path('app_etudiant_add_matiere', {'id': etudiant.id}) }}" 
           class="btn btn-success">
           <i class="bi bi-plus-circle"></i> Ajouter une matière
        </a>
    </div>

    <h4 class="mt-4 mb-3">Liste des Matières</h4>

    {% if etudiant.etudiantMatieres is empty %}
        <div class="alert alert-info">Cet étudiant n'est inscrit à aucune matière.</div>
    {% else %}
        <table class="table table-bordered table-striped align-middle shadow-sm">
            <thead class="table-dark">
                <tr>
                    <th>Matière</th>
                    <th>Absences actuelles</th>
                    <th>Max autorisées</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for etudiantMatiere in etudiant.etudiantMatieres %}
                    {% set matiere = etudiantMatiere.matiere %}
                    {# Compute current absences for this matiere dynamically #}
                    {% set currentAbsences = etudiant.absences
                        |filter(a => a.matiere.id == matiere.id)
                        |length
                    %}
                    <tr class="{% if currentAbsences >= matiere.maxAbscences %}table-warning{% endif %}">
                        <td>{{ matiere.name }}</td>
                        <td>{{ currentAbsences }}</td>
                        <td>{{ matiere.maxAbscences }}</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="{{ path('app_absence_add', {'etudiantId': etudiant.id, 'matiereId': matiere.id}) }}"
                                   class="btn btn-sm btn-success">
                                    <i class="bi bi-plus"></i>
                                </a>
                                <a href="{{ path('app_absence_remove', {'etudiantId': etudiant.id, 'matiereId': matiere.id}) }}"
                                   class="btn btn-sm btn-warning">
                                    <i class="bi bi-dash"></i>
                                </a>
                                <form method="post"
      action="{{ path('app_absence_notify', {'etudiantId': etudiant.id, 'matiereId': matiere.id}) }}"
      style="display:inline">
    <input type="hidden" name="_token" value="{{ csrf_token('notify' ~ etudiant.id ~ matiere.id) }}">
    <button class="btn btn-sm btn-outline-primary" type="submit">
        <i class="bi bi-envelope"></i> Vérifier & Notifier
    </button>
</form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <div class="mt-4">
        <a href="{{ path('app_etudiant_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
        <a href="{{ path('app_etudiant_edit', {'id': etudiant.id}) }}" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Modifier
        </a>
        {{ include('etudiant/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
