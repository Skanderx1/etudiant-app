{% extends 'base.html.twig' %}

{% block title %}Détails de l'Étudiant{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-info text-white d-flex align-items-center justify-content-between">
                    <h4 class="mb-0">
                        <i class="bi bi-person-circle me-2"></i> Détails de l'étudiant
                    </h4>
                    <a href="{{ path('app_etudiant_index') }}" class="btn btn-light btn-sm">
                        <i class="bi bi-arrow-left"></i> Retour à la liste
                    </a>
                </div>

                <div class="card-body">
                    <table class="table table-bordered align-middle">
                        <tbody>
                            <tr>
                                <th class="bg-light" style="width: 30%;">ID</th>
                                <td>{{ etudiant.id }}</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Nom</th>
                                <td>{{ etudiant.nom }}</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Prénom</th>
                                <td>{{ etudiant.prenom }}</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Email</th>
                                <td>{{ etudiant.email }}</td>
                            </tr>
                            <tr>
                                <th class="bg-light">Nombre d'absences</th>
                                <td>
                                    <span class="badge bg-warning text-dark px-3 py-2">
                                        {{ etudiant.nbreAbsence }}
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <th class="bg-light">Photo</th>
                                <td>
    {% if etudiant.photo %}
        <img src="{{ asset(photos_basepath ~ '/' ~ etudiant.photo) }}" alt="photo" class="rounded-circle" width="50" height="50">
    {% else %}
        <span class="text-muted">Aucune</span>
    {% endif %}
</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-between mt-4">
                        <div>
                            <a href="{{ path('app_etudiant_edit', {'id': etudiant.id}) }}" class="btn btn-warning text-white">
                                <i class="bi bi-pencil-square"></i> Modifier
                            </a>
                        </div>
                        <div>
                            {{ include('etudiant/_delete_form.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
