{% extends 'base.html.twig' %}

{% block title %}Etudiant{% endblock %}

{% block body %}
    <h1>Etudiant</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ etudiant.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ etudiant.nom }}</td>
            </tr>
            <tr>
                <th>Prenom</th>
                <td>{{ etudiant.prenom }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ etudiant.email }}</td>
            </tr>
            <tr>
                <th>Photo</th>
                <td>{{ etudiant.photo }}</td>
            </tr>
        </tbody>
    </table>

    <h2>Matières & Absences</h2>

    <table class="table">
        <thead>
            <tr>
                <th>Matière</th>
                <th>Absences</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for em in etudiant.etudiantMatieres %}
                <tr>
                    <td>{{ em.matiere.nom }}</td>
                    <td>{{ em.absence }}</td>
                    <td>
                        <a href="{{ path('app_etudiant_matiere_edit', {'id': em.id}) }}">Modifier</a>
                        <a href="{{ path('app_etudiant_matiere_show', {'id': em.id}) }}">Détails</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">Aucune matière/absence enregistrée pour cet étudiant.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_etudiant_matiere_new') }}">+ Ajouter absence</a>

    <br><br>

    <a href="{{ path('app_etudiant_index') }}">← Retour à la liste</a>
    <a href="{{ path('app_etudiant_edit', {'id': etudiant.id}) }}">Modifier</a>

    {{ include('etudiant/_delete_form.html.twig') }}
{% endblock %}
