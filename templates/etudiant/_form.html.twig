{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}

<div class="row g-3">
    <div class="col-md-6">
        {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.nom) }}
    </div>

    <div class="col-md-6">
        {{ form_label(form.prenom, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
        {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.prenom) }}
    </div>

    <div class="col-md-6">
        {{ form_label(form.email, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.email) }}
    </div>

    <div class="col-md-6">
        {{ form_label(form.nbreAbsence, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
        {{ form_widget(form.nbreAbsence, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.nbreAbsence) }}
    </div>

    {# File input field - the name is photoFile from the form type #}
    <div class="col-md-6">
        <label class="form-label fw-semibold">Photo</label>
        {{ form_widget(form.photoFile, {'attr': {'class': 'form-control', 'accept': 'image/*', 'id': 'photoFileInput'}}) }}
        {{ form_errors(form.photoFile) }}

        <div class="mt-3">
            {% if etudiant is defined and etudiant.photo %}
                <img id="photoPreview" src="{{ asset(photos_basepath ~ '/' ~ etudiant.photo) }}" alt="photo" class="rounded-circle border" width="100" height="100">
            {% else %}
                <img id="photoPreview" src="{{ asset('images/placeholder-user.png') }}" alt="no photo" class="rounded-circle border" width="100" height="100">
            {% endif %}
        </div>
    </div>

</div>

<div class="mt-4">
    <button type="submit" class="btn btn-success">
        <i class="bi bi-save"></i> {{ button_label|default('Enregistrer') }}
    </button>
</div>

{{ form_end(form) }}
