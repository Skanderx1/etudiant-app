{{ form_start(form, {
    'attr': {
        'class': 'needs-validation',
        'novalidate': 'novalidate',
        'enctype': 'multipart/form-data'
    }
}) }}

<div class="row g-3">
    <!-- Nom -->
    <div class="col-md-6">
        {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.nom) }}
    </div>

    <!-- Prénom -->
    <div class="col-md-6">
        {{ form_label(form.prenom, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
        {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.prenom) }}
    </div>

    <!-- Email -->
    <div class="col-md-6">
        {{ form_label(form.email, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.email) }}
    </div>

    <!-- Photo -->
    <div class="col-md-6">
        <label class="form-label fw-semibold">Photo</label>
        {{ form_widget(form.photoFile, {
            'attr': {
                'class': 'form-control',
                'accept': 'image/*',
                'id': 'photoFileInput'
            }
        }) }}
        {{ form_errors(form.photoFile) }}

        <div class="mt-3 text-center">
            {% if etudiant is defined and etudiant.photo %}
                <img id="photoPreview"
                     src="{{ asset('uploads/photos/' ~ etudiant.photo) }}"
                     alt="photo"
                     class="rounded-circle border shadow-sm"
                     width="100"
                     height="100">
            {% else %}
                <img id="photoPreview"
                     src="{{ asset('images/placeholder-user.png') }}"
                     alt="no photo"
                     class="rounded-circle border shadow-sm"
                     width="100"
                     height="100">
            {% endif %}
        </div>
    </div>
</div>

<div class="mt-4">
    <button type="submit" class="btn btn-success">
        <i class="bi bi-save"></i> {{ button_label|default('Enregistrer') }}
    </button>
</div>

{{ form_end(form) }}
