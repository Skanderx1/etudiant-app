<form method="post"
      action="{{ path('app_etudiant_delete', {'id': etudiant.id}) }}"
      onsubmit="return confirm('⚠️ Êtes-vous sûr de vouloir supprimer cet étudiant ? Cette action est irréversible.');"
      class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ etudiant.id) }}">

    <button class="btn btn-warning btn-sm">
        <i class="bi bi-trash-fill"></i> Supprimer
    </button>
</form>
