<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Gestion des Étudiants{% endblock %}</title>

    <!-- ✅ Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    >

    <!-- ✅ Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
    >

    <!-- ✅ SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

    <!-- ✅ Custom Styles -->
    <style>
      body {
        background-color: #f8f9fa;
      }

      footer {
        margin-top: 40px;
        padding: 20px 0;
        color: #777;
        background-color: #f1f1f1;
      }

      .card-shadow {
        box-shadow: 0 0.25rem 0.75rem rgba(0,0,0,0.1);
      }

      .btn-floating {
        position: fixed;
        bottom: 40px;
        right: 40px;
        z-index: 100;
        border-radius: 50%;
        width: 60px;
        height: 60px;
        font-size: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
      }
    </style>

    {% block stylesheets %}{% endblock %}
  </head>
  <body>

    <!-- ✅ Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
      <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_etudiant_index') }}">
          <i class="bi bi-mortarboard"></i> Gestion Étudiants
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link" href="{{ path('app_etudiant_index') }}">
                <i class="bi bi-list"></i> Liste
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="{{ path('app_etudiant_new') }}">
                <i class="bi bi-plus-circle"></i> Ajouter Étudiant
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="{{ path('app_matiere_new') }}">
                <i class="bi bi-book"></i> Ajouter Matière
              </a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- ✅ Main content -->
    <main class="container mt-5">
      {% block body %}{% endblock %}
    </main>

    <!-- ✅ Floating button to add Matière -->
    <a href="{{ path('app_matiere_new') }}" class="btn btn-primary btn-floating shadow-lg">
      <i class="bi bi-book"></i>
    </a>

    <!-- ✅ Footer -->
    <footer class="text-center">
      <div class="container">
        <small>&copy; {{ "now"|date("Y") }} - Application Étudiants Symfony</small>
      </div>
    </footer>

    <!-- ✅ Bootstrap JS -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-8Ndak3N9XYm5e6zZ+zXxWkQ7Qk1hcK5LOy+4xFgcA9M9QHQ9CjZwOQPt4snZ2xdv"
      crossorigin="anonymous">
    </script>

    <!-- ✅ SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js"></script>

    <!-- ✅ Custom JS -->
    {% block javascripts %}
    <script src="{{ asset('js/app.js') }}"></script>

    <script>
    document.addEventListener('DOMContentLoaded', () => {
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: '{{ label }}', // success, error, info, warning
                    title: "{{ message|e('js') }}",
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true,
                    didOpen: (toast) => {
                        toast.addEventListener('mouseenter', Swal.stopTimer)
                        toast.addEventListener('mouseleave', Swal.resumeTimer)
                    }
                });
            {% endfor %}
        {% endfor %}
    });
    </script>
    {% endblock %}

  </body>
</html>
