{% extends 'base.html.twig' %}

{% block title %}Absence{% endblock %}

{% block body %}
<h1>Absence</h1>

<table class="table table-bordered">
    <tbody>
        <tr>
            <th>Id</th>
            <td>{{ absence.id }}</td>
        </tr>
        <tr>
            <th>Étudiant</th>
            <td>{{ absence.etudiant.nom ~ ' ' ~ absence.etudiant.prenom }}</td>
        </tr>
        <tr>
            <th>Matière</th>
            <td>{{ absence.matiere.name }}</td>
        </tr>
        <tr>
            <th>Nombre d'absences</th>
            <td>{{ absence.nbrAbsences }}</td>
        </tr>
    </tbody>
</table>

<a href="{{ path('app_absence_index') }}" class="btn btn-secondary">Back to list</a>
<a href="{{ path('app_absence_edit', {'id': absence.id}) }}" class="btn btn-warning">Edit</a>
{{ include('absence/_delete_form.html.twig') }}
{% endblock %}
