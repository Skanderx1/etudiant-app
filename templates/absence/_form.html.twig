{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}

<div class="row g-3">
    <div class="col-md-6">
        {{ form_label(form.etudiant, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
        {{ form_widget(form.etudiant, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.etudiant) }}
    </div>

    <div class="col-md-6">
        {{ form_label(form.matiere, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
        {{ form_widget(form.matiere, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.matiere) }}
    </div>

    <div class="col-md-6">
        {{ form_label(form.nbrAbsences, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
        {{ form_widget(form.nbrAbsences, {'attr': {'class': 'form-control', 'min': 0}}) }}
        {{ form_errors(form.nbrAbsences) }}
    </div>
</div>

<div class="mt-4">
    <button type="submit" class="btn btn-success">
        <i class="bi bi-save"></i> {{ button_label|default('Enregistrer') }}
    </button>
</div>

{{ form_end(form) }}
